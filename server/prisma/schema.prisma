datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Roles
model Role {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

// 2. Permissions
model Permission {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  module      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@map("permissions")
}

// 3. Role Permissions
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// 4. Stores
model Store {
  id            String    @id @default(uuid())
  name          String
  code          String?
  logo          String?
  address       String?
  phone         String?
  email         String?
  taxNumber     String?   @map("tax_number")
  currency      String    @default("PKR")
  receiptHeader String?   @map("receipt_header") @db.Text
  receiptFooter String?   @map("receipt_footer") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  branches      Branch[]
  products      Product[]

  @@map("stores")
}

// 5. Branches
model Branch {
  id                 String          @id @default(uuid())
  storeId            String          @map("store_id")
  name               String
  code               String          @unique
  address            String?
  phone              String?
  isMain             Boolean         @default(false) @map("is_main")
  status             String          @default("ACTIVE")
  createdAt          DateTime        @default(now()) @map("created_at")
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  users              User[]
  sales              Sale[]
  purchases          Purchase[]
  stockMovements     StockMovement[]
  outgoingTransfers  StockTransfer[] @relation("TransferFrom")
  incomingTransfers  StockTransfer[] @relation("TransferTo")
  expenses           Expense[]
  cashRegisters      CashRegister[]
  returns            Return[]

  @@map("branches")
}

// 6. Users
model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  password       String
  roleId         String          @map("role_id")
  branchId       String?         @map("branch_id")
  phone          String?
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  role           Role            @relation(fields: [roleId], references: [id])
  branch         Branch?         @relation(fields: [branchId], references: [id])
  sales          Sale[]
  purchases      Purchase[]
  auditLogs      AuditLog[]
  cashRegisters  CashRegister[]
  stockMovements StockMovement[]
  expenses       Expense[]

  @@map("users")
}

// 7. Categories
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?    @map("parent_id")
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now()) @map("created_at")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

// 8. Brands
model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  logo        String?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now()) @map("created_at")
  products    Product[]

  @@map("brands")
}

// 9. Sizes
model Size {
  id        String           @id @default(uuid())
  name      String
  code      String           @unique
  sortOrder Int              @default(0) @map("sort_order")
  variants  ProductVariant[]

  @@map("sizes")
}

// 10. Colors
model Color {
  id       String           @id @default(uuid())
  name     String
  hexCode  String           @map("hex_code")
  variants ProductVariant[]

  @@map("colors")
}

// 11. Products
model Product {
  id          String           @id @default(uuid())
  storeId     String?          @map("store_id")
  categoryId  String           @map("category_id")
  brandId     String?          @map("brand_id")
  name        String
  slug        String           @unique
  description String?          @db.Text
  image       String?
  basePrice   Decimal          @default(0.00) @map("base_price") @db.Decimal(10, 2)
  status      String           @default("ACTIVE")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  store       Store?           @relation(fields: [storeId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]

  @@map("products")
}

// 12. Product Variants
model ProductVariant {
  id             String          @id @default(uuid())
  productId      String          @map("product_id")
  sizeId         String?         @map("size_id")
  colorId        String?         @map("color_id")
  fabric         String?
  pattern        String?
  season         String?
  sku            String          @unique
  barcode        String          @unique
  purchasePrice  Decimal         @default(0.00) @map("purchase_price") @db.Decimal(10, 2)
  sellingPrice   Decimal         @default(0.00) @map("selling_price") @db.Decimal(10, 2)
  wholesalePrice Decimal         @default(0.00) @map("wholesale_price") @db.Decimal(10, 2)
  discountPrice  Decimal?        @map("discount_price") @db.Decimal(10, 2)
  stockQuantity  Int             @default(0) @map("stock_quantity")
  minStockAlert  Int             @default(5) @map("min_stock_alert")
  status         String          @default("ACTIVE")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           Size?           @relation(fields: [sizeId], references: [id])
  color          Color?          @relation(fields: [colorId], references: [id])
  barcodes       Barcode[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]    @relation("ReturnedVariant")
  exchangeItems  ReturnItem[]    @relation("ExchangeVariant")
  stockMovements StockMovement[]

  @@map("product_variants")
}

// 13. Barcodes
model Barcode {
  id        String         @id @default(uuid())
  variantId String         @map("variant_id")
  barcode   String         @unique
  format    String         @default("CODE128")
  isPrimary Boolean        @default(true) @map("is_primary")
  createdAt DateTime       @default(now()) @map("created_at")
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("barcodes")
}

// 14. Suppliers
model Supplier {
  id          String            @id @default(uuid())
  name        String
  companyName String            @map("company_name")
  email       String?
  phone       String?
  address     String?
  taxNumber   String?           @map("tax_number")
  balance     Decimal           @default(0.00) @db.Decimal(12, 2)
  status      String            @default("ACTIVE")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  purchases   Purchase[]
  payments    PurchasePayment[]
  ledger      SupplierLedger[]

  @@map("suppliers")
}

// 15. Purchases
model Purchase {
  id             String            @id @default(uuid())
  invoiceNumber  String            @unique @map("invoice_number")
  supplierId     String            @map("supplier_id")
  branchId       String?           @map("branch_id")
  purchaseDate   DateTime          @default(now()) @map("purchase_date")
  totalAmount    Decimal           @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  discountAmount Decimal           @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal           @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  netAmount      Decimal           @default(0.00) @map("net_amount") @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  balanceAmount  Decimal           @default(0.00) @map("balance_amount") @db.Decimal(12, 2)
  paymentStatus  String            @default("PENDING") @map("payment_status")
  status         String            @default("RECEIVED")
  notes          String?           @db.Text
  createdBy      String?           @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  supplier       Supplier          @relation(fields: [supplierId], references: [id])
  branch         Branch?           @relation(fields: [branchId], references: [id])
  user           User?             @relation(fields: [createdBy], references: [id])
  items          PurchaseItem[]
  payments       PurchasePayment[]

  @@map("purchases")
}

// 16. Purchase Items
model PurchaseItem {
  id         String         @id @default(uuid())
  purchaseId String         @map("purchase_id")
  variantId  String         @map("variant_id")
  quantity   Int
  unitCost   Decimal        @map("unit_cost") @db.Decimal(10, 2)
  subtotal   Decimal        @db.Decimal(12, 2)
  taxAmount  Decimal        @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  totalCost  Decimal        @map("total_cost") @db.Decimal(12, 2)
  createdAt  DateTime       @default(now()) @map("created_at")
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_items")
}

// 17. Purchase Payments
model PurchasePayment {
  id            String    @id @default(uuid())
  purchaseId    String?   @map("purchase_id")
  supplierId    String    @map("supplier_id")
  amount        Decimal   @db.Decimal(12, 2)
  paymentMethod String    @map("payment_method")
  paymentDate   DateTime  @default(now()) @map("payment_date")
  referenceNo   String?   @map("reference_no")
  notes         String?
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])

  @@map("purchase_payments")
}

// 18. Customers
model Customer {
  id            String           @id @default(uuid())
  name          String
  phone         String?          @unique
  email         String?
  address       String?
  loyaltyPoints Int              @default(0) @map("loyalty_points")
  balance       Decimal          @default(0.00) @db.Decimal(12, 2)
  totalSpent    Decimal          @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  notes         String?
  status        String           @default("ACTIVE")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  sales         Sale[]
  returns       Return[]
  ledger        CustomerLedger[]

  @@map("customers")
}

// 19. Sales
model Sale {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  branchId        String?       @map("branch_id")
  customerId      String?       @map("customer_id")
  userId          String?       @map("user_id")
  saleDate        DateTime      @default(now()) @map("sale_date")
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  discountPercent Decimal       @default(0.00) @map("discount_percent") @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  taxPercent      Decimal       @default(0.00) @map("tax_percent") @db.Decimal(5, 2)
  grandTotal      Decimal       @map("grand_total") @db.Decimal(12, 2)
  paidAmount      Decimal       @default(0.00) @map("paid_amount") @db.Decimal(12, 2)
  changeAmount    Decimal       @default(0.00) @map("change_amount") @db.Decimal(10, 2)
  balanceDue      Decimal       @default(0.00) @map("balance_due") @db.Decimal(12, 2)
  paymentStatus   String        @default("PAID") @map("payment_status")
  status          String        @default("COMPLETED")
  orderNotes      String?       @map("order_notes")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  branch          Branch?       @relation(fields: [branchId], references: [id])
  customer        Customer?     @relation(fields: [customerId], references: [id])
  user            User?         @relation(fields: [userId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  returns         Return[]

  @@map("sales")
}

// 20. Sale Items
model SaleItem {
  id             String         @id @default(uuid())
  saleId         String         @map("sale_id")
  variantId      String         @map("variant_id")
  quantity       Int
  unitPrice      Decimal        @map("unit_price") @db.Decimal(10, 2)
  costPrice      Decimal        @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  discountAmount Decimal        @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  taxAmount      Decimal        @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  subtotal       Decimal        @db.Decimal(12, 2)
  total          Decimal        @db.Decimal(12, 2)
  createdAt      DateTime       @default(now()) @map("created_at")
  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  returnItems    ReturnItem[]

  @@map("sale_items")
}

// 21. Sale Payments
model SalePayment {
  id             String   @id @default(uuid())
  saleId         String   @map("sale_id")
  paymentMethod  String   @map("payment_method")
  amount         Decimal  @db.Decimal(12, 2)
  receivedAmount Decimal  @default(0.00) @map("received_amount") @db.Decimal(12, 2)
  changeAmount   Decimal  @default(0.00) @map("change_amount") @db.Decimal(10, 2)
  transactionRef String?  @map("transaction_ref")
  notes          String?
  createdAt      DateTime @default(now()) @map("created_at")
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_payments")
}

// 22. Returns
model Return {
  id                 String       @id @default(uuid())
  returnNumber       String       @unique @map("return_number")
  saleId             String       @map("sale_id")
  customerId         String?      @map("customer_id")
  branchId           String?      @map("branch_id")
  userId             String?      @map("user_id")
  returnDate         DateTime     @default(now()) @map("return_date")
  totalRefundAmount  Decimal      @default(0.00) @map("total_refund_amount") @db.Decimal(12, 2)
  returnReason       String?      @map("return_reason")
  exchangeDifference Decimal      @default(0.00) @map("exchange_difference") @db.Decimal(10, 2)
  status             String       @default("COMPLETED")
  notes              String?
  createdAt          DateTime     @default(now()) @map("created_at")
  sale               Sale         @relation(fields: [saleId], references: [id])
  customer           Customer?    @relation(fields: [customerId], references: [id])
  branch             Branch?      @relation(fields: [branchId], references: [id])
  items              ReturnItem[]

  @@map("returns")
}

// 23. Return Items
model ReturnItem {
  id                String          @id @default(uuid())
  returnId          String          @map("return_id")
  saleItemId        String?         @map("sale_item_id")
  variantId         String          @map("variant_id")
  quantity          Int
  unitPrice         Decimal         @map("unit_price") @db.Decimal(10, 2)
  refundAmount      Decimal         @map("refund_amount") @db.Decimal(12, 2)
  conditionStatus   String          @default("GOOD") @map("condition_status")
  restockStatus     Boolean         @default(true) @map("restock_status")
  exchangeVariantId String?         @map("exchange_variant_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  returnModel       Return          @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem          SaleItem?       @relation(fields: [saleItemId], references: [id])
  variant           ProductVariant  @relation("ReturnedVariant", fields: [variantId], references: [id])
  exchangeVariant   ProductVariant? @relation("ExchangeVariant", fields: [exchangeVariantId], references: [id])

  @@map("return_items")
}

// 24. Stock Movements
model StockMovement {
  id            String         @id @default(uuid())
  variantId     String         @map("variant_id")
  branchId      String?        @map("branch_id")
  movementType  String         @map("movement_type")
  quantity      Int
  referenceId   String?        @map("reference_id")
  referenceType String?        @map("reference_type")
  costPrice     Decimal        @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  notes         String?
  createdBy     String?        @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  variant       ProductVariant @relation(fields: [variantId], references: [id])
  branch        Branch?        @relation(fields: [branchId], references: [id])
  user          User?          @relation(fields: [createdBy], references: [id])

  @@map("stock_movements")
}

// 25. Stock Transfers
model StockTransfer {
  id             String    @id @default(uuid())
  transferNumber String    @unique @map("transfer_number")
  fromBranchId   String    @map("from_branch_id")
  toBranchId     String    @map("to_branch_id")
  status         String    @default("PENDING")
  transferDate   DateTime  @default(now()) @map("transfer_date")
  receivedDate   DateTime? @map("received_date")
  notes          String?
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  fromBranch     Branch    @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch       Branch    @relation("TransferTo", fields: [toBranchId], references: [id])

  @@map("stock_transfers")
}

// 26. Expenses
model Expense {
  id            String   @id @default(uuid())
  branchId      String?  @map("branch_id")
  category      String
  title         String
  amount        Decimal  @db.Decimal(10, 2)
  expenseDate   DateTime @default(now()) @map("expense_date")
  paymentMethod String   @default("CASH") @map("payment_method")
  receiptImage  String?  @map("receipt_image")
  notes         String?
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  branch        Branch?  @relation(fields: [branchId], references: [id])
  user          User?    @relation(fields: [createdBy], references: [id])

  @@map("expenses")
}

// 27. Cash Registers
model CashRegister {
  id             String    @id @default(uuid())
  branchId       String?   @map("branch_id")
  userId         String    @map("user_id")
  openedAt       DateTime  @default(now()) @map("opened_at")
  closedAt       DateTime? @map("closed_at")
  openingBalance Decimal   @default(0.00) @map("opening_balance") @db.Decimal(10, 2)
  closingBalance Decimal?  @map("closing_balance") @db.Decimal(10, 2)
  cashSales      Decimal   @default(0.00) @map("cash_sales") @db.Decimal(12, 2)
  cardSales      Decimal   @default(0.00) @map("card_sales") @db.Decimal(12, 2)
  otherSales     Decimal   @default(0.00) @map("other_sales") @db.Decimal(12, 2)
  totalCashIn    Decimal   @default(0.00) @map("total_cash_in") @db.Decimal(10, 2)
  totalCashOut   Decimal   @default(0.00) @map("total_cash_out") @db.Decimal(10, 2)
  expectedClosing Decimal? @map("expected_closing") @db.Decimal(10, 2)
  difference     Decimal?  @db.Decimal(10, 2)
  status         String    @default("OPEN")
  notes          String?
  branch         Branch?   @relation(fields: [branchId], references: [id])
  user           User      @relation(fields: [userId], references: [id])

  @@map("cash_registers")
}

// 28. Customer Ledger
model CustomerLedger {
  id              String   @id @default(uuid())
  customerId      String   @map("customer_id")
  transactionType String   @map("transaction_type")
  referenceId     String?  @map("reference_id")
  debit           Decimal  @default(0.00) @db.Decimal(12, 2)
  credit          Decimal  @default(0.00) @db.Decimal(12, 2)
  balance         Decimal  @db.Decimal(12, 2)
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  customer        Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_ledger")
}

// 29. Supplier Ledger
model SupplierLedger {
  id              String   @id @default(uuid())
  supplierId      String   @map("supplier_id")
  transactionType String   @map("transaction_type")
  referenceId     String?  @map("reference_id")
  debit           Decimal  @default(0.00) @db.Decimal(12, 2)
  credit          Decimal  @default(0.00) @db.Decimal(12, 2)
  balance         Decimal  @db.Decimal(12, 2)
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")
  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@map("supplier_ledger")
}

// 30. Audit Logs
model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  module    String
  recordId  String?  @map("record_id")
  details   String?  @db.Text
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// 31. Settings
model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  groupName String   @default("GENERAL") @map("group_name")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
